[module]
name = crypto_accelerator
version = 1.0.0
description = Experimental Cryptographic Accelerator Module with Non-Monolithic Auto-Registered Functions
author = Dvargosh Dev Team
secured_memory_kb = 2048
domains = accelerator:hash, accelerator:cipher, *
