    {
      "name": "crypto_accelerator",
      "version": "1.0.0",
      "description": "Experimental Cryptographic Accelerator Module with Non-Monolithic Auto-Registered Functions",
      "author": "Dvargosh Dev Team",
      "secured_memory_kb": 2048,
      "domains": [
        "accelerator:cipher",
        "accelerator:hash",
        "*"
      ],
      "functions": [
        {
          "function": "accelerator_sha256",
          "domain": "accelerator:hash",
          "description": "Pipeline-attributed service method 'accelerator_sha256'",
          "source_file": "hasher.cpp",
          "ret_type": "std::string",
          "params": "const std::string& input",
          "is_macro_export": false
        },
        {
          "function": "accelerator_rot13",
          "domain": "accelerator:cipher",
          "description": "Pipeline-attributed service method 'accelerator_rot13'",
          "source_file": "cipher.cpp",
          "ret_type": "std::string",
          "params": "const std::string& input",
          "is_macro_export": false
        }
      ],
      "sources": [
        "_generated_registration.cpp",
        "accelerator_module.cpp",
        "cipher.cpp",
        "hasher.cpp"
      ]
    },
