[module]
name = demo_pkg
version = 1.0.0
description = Full Demo Package with Subsystems (Domains) and Inter-Subsystem Access Control
author = Dvargosh Team
secured_memory_kb = 4096
domains = demo_pkg:vault, demo_pkg:worker, *
sources = _module_header.cpp, demo_module.cpp, ops_calc.cpp, ops_crypto.cpp
link_libraries = dvargosh_core
auto_load = true
