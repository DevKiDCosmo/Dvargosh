[module]
name = stdnet
version = 1.0.0
description = Dvargosh Standard Library: networking (URI, DNS/IP resolution, TCP, UDP, HTTP packaging)
author = Dvargosh Team
secured_memory_kb = 1024
permissions = ServiceRegister, DynamicInvoke, NetworkAccess
domains = std:net, *
sources = stdnet_module.cpp, stdnet.services.cpp, stdnet_service.cpp, stdnet_uri.cpp, stdnet_dns.cpp, stdnet_socket.cpp, stdnet_http.cpp, stdnet_reactor.cpp, stdnet_tls.cpp, stdnet_http_server.cpp
link_libraries = dvargosh_core
auto_load = true
