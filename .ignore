#include "dvargosh/dvargosh.hpp"
#include <string>

namespace dvargosh {

DVARGOSH_SERVICE(captives:hello_world)
std::string hello_world(const std::string& input) {
    return "HELLO_WORLD_" + input;
}

// 2. Safe Space Authorized Accessor
// Function residing inside the protected "captives:vault" domain
DVARGOSH_SERVICE(captives:vault)
std::string get_safe_vault_key() {
    auto* ctx = Runtime::get_context();
    if (!ctx || !ctx->domain_manager()) return "ERROR_NO_CONTEXT";

    // 1. Explicit domain security check: verify caller is neither blacklisted nor unauthorized
    std::string caller = ExecutionContext::current_domain();
    if (ctx->domain_manager()->is_cross_domain_blacklisted(caller, "captives:vault")) {
        return "ACCESS_DENIED: Calling domain '" + caller + "' is explicitly blacklisted";
    }

    // 2. Authorized access: caller domain is automatically resolved as ExecutionContext::current_domain()
    // and verified by get_domain_vault() using the permission matrix (blacklist + whitelist)
    auto vault_res = ctx->domain_manager()->get_domain_vault("captives:vault", "captives_vault");
    if (!vault_res.is_ok()) {
        return "ACCESS_DENIED: " + vault_res.error_message();
    }

    auto secret_res = vault_res.value()->read_secret("ROOT_KEY");
    if (!secret_res.is_ok()) {
        return "READ_FAILED: " + secret_res.error_message();
    }

    return secret_res.value();
}

// 3. Unauthorized Cross-Domain Memory / Vault Access Attempt
// Function residing in "captives:intruder" domain trying to breach "captives:vault"
DVARGOSH_SERVICE(captives:intruder)
std::string intruder_access_safe_space() {
    auto* ctx = Runtime::get_context();
    if (!ctx || !ctx->domain_manager()) return "ERROR_NO_CONTEXT";

    // Executing domain is automatically resolved as "captives:intruder"
    // Attempting cross-domain vault access without permissions is rejected
    auto vault_res = ctx->domain_manager()->get_domain_vault("captives:vault", "captives_vault");
    if (!vault_res.is_ok()) {
        return "REJECTED: " + vault_res.error_message();
    }

    auto secret_res = vault_res.value()->read_secret("ROOT_KEY");
    if (!secret_res.is_ok()) {
        return "REJECTED: " + secret_res.error_message();
    }

    return "UNEXPECTED_BREACH_SUCCESS";
}

// 4. Domain Spoofing / Tampering Attempt
// Intruder attempts to falsify caller domain identity to bypass security
DVARGOSH_SERVICE(captives:intruder)
std::string intruder_tamper_attempt() {
    auto* ctx = Runtime::get_context();
    if (!ctx || !ctx->domain_manager()) return "ERROR_NO_CONTEXT";

    // Executing frame is "captives:intruder", but intruder attempts to pass "captives:vault"
    auto spoof_res = ctx->domain_manager()->get_domain_space("captives:vault", "captives:vault");
    if (!spoof_res.is_ok()) {
        return "TAMPER_DETECTED: " + spoof_res.error_message();
    }

    return "TAMPER_UNNOTICED_FAILURE";
}

// 5. Unauthorized Cross-Domain RPC Invocation Attempt
// Function in "captives:intruder" domain trying to invoke a service in "captives:vault"
DVARGOSH_SERVICE(captives:intruder)
std::string intruder_invoke_vault() {
    auto* ctx = Runtime::get_context();
    if (!ctx || !ctx->registry()) return "ERROR_NO_CONTEXT";

    // Attempt RPC call from executing domain "captives:intruder" to target "captives:vault"
    auto res = ctx->call("hello_world.get_safe_vault_key", {});
    if (!res.is_ok()) {
        return "REJECTED: " + res.error_message();
    }

    return res.value().to_string();
}

// 6. Correct cross-module invocation via host context
DVARGOSH_SERVICE(captives:hello_world)
std::string invokeothers() {
    auto* ctx = Runtime::get_context();
    if (!ctx) return "Error: No active module context";

    auto hash_res = ctx->call("demo_pkg.demo_pkg_vault_hash", {Value("DvargoshData")});
    return hash_res.is_ok() ? hash_res.value().to_string() : "Error: " + hash_res.error_message();
}

extern void* just_true();
DVARGOSH_EXPORT_FN(just_true, "value", "JUST TRUE") {
    auto* ctx = Runtime::get_context();
    if (!ctx) return Result<Value>::failure(StatusCode(23), "Error: No active module context");
    
    std::string caller = ExecutionContext::current_domain();
    DomainManager* dm = ctx ? ctx->domain_manager() : nullptr;
    if (dm && dm->is_cross_domain_blacklisted(caller, "value")) {
        return Result<Value>::failure(StatusCode(24), "Error: Calling domain is explicitly blacklisted");
    }
    
    // Invoke logger.debug using authentic local context (logger.* is an open wildcard)
    if (ctx) {
        ctx->requireModule("logger");
        ctx->requireModule("apsodkapsokdpaoskdpaoskd");
        ctx->call("logger.debug", {Value("just_true called via authentic ModuleContext")});
    }

    std::cout << "just_true called" << std::endl;
    return Result<Value>::success(Value(true));
}

DVARGOSH_EXPORT_ALIAS_OVERRIDE(just_true, "k");
// DVARGOSH_EXPORT_REQUIRED_ARGS(just_true, 1);

} // namespace dvargosh


#include "dvargosh/dvargosh.hpp"
#include <iostream>
#include <cstring>

namespace dvargosh {

class HelloWorldModule : public IModule {
public:
    const ModuleManifest& manifest() const override {
        static ModuleManifest s_manifest = []() {
            ModuleManifest m;
            m.name = "hello_world";
            m.domain = "*";
            m.version = Version{1, 0, 0};
            m.description = "Hello World module with hardware-guarded safe space and domain isolation";
            m.author = "I am Nam";
            m.requested_permissions = PermissionSet::all();
            return m;
        }();
        return s_manifest;
    }

    Result<void> on_load(ModuleContext& ctx) override {
        DomainManager* dm = ctx.domain_manager();
        if (dm) {
            // 1. Safe space: initialize domain "captives:vault" with strict policy
            dm->create_domain("captives:vault", SecurityPolicy::strict(), 64 * 1024, true);

            // Create high-security cryptographic Vault inside "captives:vault"
            VaultConfig vcfg;
            vcfg.name = "captives_vault";
            vcfg.owner_domain = "captives:vault";
            vcfg.owner_module = "hello_world";
            vcfg.capacity_bytes = 64 * 1024;
            vcfg.security_level = VaultSecurityLevel::TamperProof;
            vcfg.use_guard_pages = true;
            vcfg.auto_seal_on_write = true;
            vcfg.description = "Hardware-guarded high-security cryptographic vault storing root captives tokens.";

            auto vault_res = dm->create_vault(vcfg);
            if (vault_res.is_ok()) {
                // Safely write the secret key into the sealed vault
                vault_res.value()->write_secret("ROOT_KEY", "SECURE_KEY_NAM_CAPTIVES_9988_XYZ");
            }

            // 2. Intruder domain: "captives:intruder" with NO access granted to "captives:vault"
            dm->create_domain("captives:intruder", SecurityPolicy::strict());

            // 3. Normal domain: "captives:hello_world"
            dm->create_domain("captives:hello_world", SecurityPolicy::standard());
            // Explicitly authorize captives:hello_world to access demo_pkg:vault services
            dm->allow_cross_domain("captives:hello_world", "demo_pkg:vault");
            dm->allow_cross_domain("captives:hello_world", "core");

            // 4. Domain: "value" (for just_true) with permission to access core logging
            dm->create_domain("value", SecurityPolicy::standard());
            dm->allow_cross_domain("value", "core"); // TODO: WARNING POSSIBLE SECURITY VULNERABILITY
            // ARD: This is for self regulatory.
        }

        register_auto_functions(ctx);
        return Result<void>::success();
    }

    Result<void> on_start(ModuleContext&) override { return Result<void>::success(); }
    Result<void> on_stop(ModuleContext&) override { return Result<void>::success(); }
    Result<void> on_unload(ModuleContext&) override { return Result<void>::success(); }
};

} // namespace dvargosh

DVARGOSH_EXPORT_MODULE(dvargosh::HelloWorldModule)



